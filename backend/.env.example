AWARE_ENVIRONMENT=development
AWARE_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
AWARE_JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-48
AWARE_TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# smallest.ai — https://app.smallest.ai → API Keys
AWARE_SMALLEST_API_KEY=your-smallest-api-key-here
AWARE_TTS_VOICE_ID=emily
AWARE_TTS_SAMPLE_RATE=24000

# OpenAI — set to your current model name (e.g. gpt-4o, gpt-4.1, gpt-5)
AWARE_OPENAI_API_KEY=your-openai-api-key-here
AWARE_OPENAI_MODEL=gpt-4o
